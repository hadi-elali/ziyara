{
  "name": "ziyara",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "dependencies": {
    "@expo/ui": "~57.0.19",
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.24",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.2",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.4",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "supabase": "^2.114.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "generate:leaflet-assets": "node scripts/generate-leaflet-assets.mjs",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test:coverage && npx expo install --check"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/e2e/"
    ],
    "watchman": false,
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/data/**/*.{ts,tsx}",
      "src/features/auth/{RequireAuth,auth-context,password-recovery-link,protected-route-policy}.{ts,tsx}",
      "src/features/bus-management/{bus-management-context,bus-management-state}.{ts,tsx}",
      "src/features/daily-program/{daily-program-context,daily-program-state}.{ts,tsx}",
      "src/features/errors/AppErrorBoundary.tsx",
      "src/features/group-check/{group-check-context,group-check-results}.{ts,tsx}",
      "src/features/general-alarm/general-alarm-reminders.ts",
      "src/features/i18n/**/*.{ts,tsx}",
      "src/features/navigation/**/*.{ts,tsx}",
      "src/features/network/**/*.{ts,tsx}",
      "src/features/places/openNavigation.ts",
      "src/features/question-round/question-round-context.tsx",
      "src/features/storage/**/*.{ts,tsx}",
      "src/features/theme/**/*.{ts,tsx}",
      "src/features/trip-guidance/{trip-guidance-context,trip-guidance-state}.{ts,tsx}",
      "src/features/trip-groups/{trip-group-context,trip-group-state}.{ts,tsx}",
      "src/hooks/**/*.{ts,tsx}",
      "supabase/functions/delete-account/handler.ts",
      "supabase/functions/dispatch-general-alarm/handler.ts",
      "!**/*.test.{ts,tsx}"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 50
      },
      "./src/features/auth/auth-context.tsx": {
        "lines": 80
      },
      "./src/features/bus-management/bus-management-context.tsx": {
        "lines": 80
      },
      "./src/features/group-check/group-check-context.tsx": {
        "lines": 80
      },
      "./src/features/question-round/question-round-context.tsx": {
        "lines": 80
      },
      "./src/features/trip-guidance/trip-guidance-context.tsx": {
        "lines": 80
      }
    }
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "@expo/dom-webview",
          "react-native-maps"
        ]
      },
      "ios": {
        "exclude": [
          "@expo/dom-webview",
          "react-native-webview"
        ]
      }
    }
  },
  "private": true
}
